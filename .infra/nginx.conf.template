# Template processado no boot pelo entrypoint da imagem nginx (envsubst nos
# `${...}`) → /etc/nginx/conf.d/default.conf. O `$uri` sobrevive porque o
# entrypoint só substitui as variáveis presentes no ambiente.
#
# ${BASE_PATH} vem do Dockerfile — a MESMA variável do build do Vite e do destino
# do dist. Barra no início e no fim (ex.: `/portal/100-questoes-do-enem/`).
# ${PREPARADAO_PATH} é uma entrada alternativa que serve o mesmo index sem
# redirecionar, para que o React consiga identificar a URL e pular o formulário.
server {
  listen       80;
  server_name  _;
  root   /usr/share/nginx/html;
  index  index.html;

  # Location relativo nos redirects: atrás do proxy, um Location absoluto vazaria
  # o host interno `100-questoes-enem.quero.app` pra barra de endereço.
  absolute_redirect off;

  # A raiz não serve o app (o build vive sob ${BASE_PATH}).
  location = / {
    return 302 ${BASE_PATH};
  }

  # Entrada do Preparadão: mantém a URL alternativa no navegador, mas entrega o
  # mesmo index e os mesmos assets do build canônico em ${BASE_PATH}.
  location = ${PREPARADAO_PATH} {
    add_header Cache-Control "no-cache, no-store, must-revalidate";
    try_files ${BASE_PATH}index.html =404;
  }

  location = ${PREPARADAO_PATH}/ {
    add_header Cache-Control "no-cache, no-store, must-revalidate";
    try_files ${BASE_PATH}index.html =404;
  }

  # Assets com hash no nome: cache longo.
  location ${BASE_PATH}assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  # O mime.types padrão do nginx não mapeia .ttf (sairia application/octet-stream).
  location ${BASE_PATH}brand/fonts/ {
    default_type font/ttf;
  }

  # O app não tem rotas no client: path desconhecido é 404.
  location ${BASE_PATH} {
    try_files $uri $uri/ =404;
  }

  # O index.html nunca é cacheado: ele aponta pro JS/CSS com hash do deploy atual.
  location = ${BASE_PATH}index.html {
    add_header Cache-Control "no-cache, no-store, must-revalidate";
  }

  gzip on;
  gzip_types text/plain text/css application/javascript application/json image/svg+xml;
  gzip_min_length 1024;
}
